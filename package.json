{
  "name": "mission-control",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=26.3.0"
  },
  "scripts": {
    "build": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t build",
    "check:changed-ts-size": "node --experimental-strip-types scripts/changed-typescript-size.ts",
    "dev:cli": "pnpm --filter @mission-control/cli dev",
    "dev:desktop": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run desktop:dev",
    "dev:package-cli": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run workspace:package-cli",
    "dev:sidecar": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run sidecar:dev --",
    "lint": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run workspace:lint",
    "biome:check": "biome check",
    "biome:check:write": "biome check --write",
    "biome:format": "biome format --write",
    "biome:lint": "biome lint",
    "biome:ci": "biome ci",
    "smoke:coding-agent-built-dist": "node --experimental-strip-types scripts/coding-agent-built-dist-smoke.ts",
    "smoke:coding-agent-mcp-tools": "node --experimental-strip-types scripts/coding-agent-built-dist-mcp-smoke.ts",
    "test": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t test --parallel=1",
    "typecheck": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@mission-control/cli": "workspace:*",
    "@mission-control/config": "workspace:*",
    "@mission-control/core": "workspace:*",
    "@mission-control/protocol": "workspace:*",
    "@opentui/solid": "^0.4.5",
    "@types/node": "^26.1.1",
    "@types/semver": "^7.7.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "diff": "^9.0.0",
    "nx": "23.1.0",
    "semver": "^7.8.5",
    "solid-js": "1.9.14",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^4.1.10",
    "web-tree-sitter": "0.25.10"
  },
  "pnpm": {
    "overrides": {
      "solid-js": "1.9.14"
    }
  }
}
