{
  "name": "@mission-control/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "import": "./dist/replay.js"
    },
    "./redaction": {
      "types": "./dist/redaction.d.ts",
      "import": "./dist/redaction.js"
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && node ../../scripts/generate-bundled-agents.mjs",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "sh -c 'cd ../.. && while [ \"${1:-}\" = \"--\" ]; do shift; done; vitest run --reporter verbose \"$@\"' --",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.17",
    "@ai-sdk/google": "^4.0.20",
    "@ai-sdk/openai": "^4.0.17",
    "@libsql/client": "^0.17.0",
    "@mission-control/config": "workspace:*",
    "@mission-control/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^7.0.33",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.0",
    "puppeteer-core": "^25.3.0",
    "yaml": "^2.4.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.3"
  }
}
