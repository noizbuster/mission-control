{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "tui",
  "projectType": "application",
  "root": "apps/tui",
  "sourceRoot": "apps/tui/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/tui",
        "command": "vite build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/tui",
        "command": "tsc -p tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --environment node --config apps/tui/vite.config.ts apps/tui/src --reporter verbose"
      }
    }
  }
}
