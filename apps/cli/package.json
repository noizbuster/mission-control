{
  "name": "@mission-control/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Mission Control CLI TUI",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "mc": "./dist/index.js",
    "mctrl": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./args": {
      "types": "./dist/args.d.ts",
      "import": "./dist/args.js"
    },
    "./commands/run-agent": {
      "types": "./dist/commands/run-agent.d.ts",
      "import": "./dist/commands/run-agent.js"
    },
    "./commands/session": {
      "types": "./dist/commands/session.d.ts",
      "import": "./dist/commands/session.js"
    },
    "./commands/mission-control-services": {
      "types": "./dist/commands/mission-control-services.d.ts",
      "import": "./dist/commands/mission-control-services.js"
    }
  },
  "scripts": {
    "prebuild": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run tui:build",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "pnpm build && node --experimental-ffi dist/index.js",
    "test": "sh -c 'cd ../.. && while [ \"${1:-}\" = \"--\" ]; do shift; done; vitest run --reporter verbose \"$@\"' --",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mission-control/config": "workspace:*",
    "@mission-control/core": "workspace:*",
    "@mission-control/protocol": "workspace:*",
    "@mission-control/tui": "workspace:*"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.3",
    "ai": "^7.0.36",
    "vite": "^8.1.5",
    "zod": "^4.4.3"
  }
}
